# Environment variables template for HAPPY EVENTS

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/happy_events?schema=public"

# NextAuth / Auth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-very-secure-random-secret-key-32-chars-minimum"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Cloud Storage (S3 / R2)
# S3_ENDPOINT="https://..."
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_BUCKET_NAME="happy-events"

# Optional AI Provider
# AI_PROVIDER="openai" # or "anthropic" / "gemini"
# AI_API_KEY="..."

# Optional WhatsApp Cloud API
# WHATSAPP_API_TOKEN="..."
# WHATSAPP_PHONE_NUMBER_ID="..."
